# Copy to .env to customise. Every value is optional.

# Where "/api" requests are forwarded — by the Vite dev server (npm run dev) and by
# the nginx container (docker compose up). No trailing slash, no path.
BACKEND_ORIGIN=https://curaflow-backend-pfrn.onrender.com
# BACKEND_ORIGIN=http://localhost:8000              # backend on your machine, with `npm run dev`
# BACKEND_ORIGIN=http://host.docker.internal:8000   # backend on your machine, with Docker (localhost = the container itself)

# Host port for the nginx container (docker compose up)
# WEB_PORT=3000

# Call a backend directly instead of through the proxy (build-time; cross-origin, so the
# backend's CORS_ORIGIN must allow this app's origin). Normally leave unset.
# VITE_API_BASE_URL=https://curaflow-backend-pfrn.onrender.com/api/v1

# docker compose --profile dev: set if hot reload doesn't notice file changes
# VITE_USE_POLLING=true
